{
    "name": "annotation-capture",
    "productName": "AnnotationCapture",
    "version": "0.2.0",
    "description": "截图批注归档与选定公式识别",
    "main": "./out/main/main.js",
    "scripts": {
        "pack": "npm run build && node scripts/prepare-package.cjs && electron-builder --dir -c annotation-builder.config.cjs",
        "dist": "npm run release:win",
        "start": "electron-vite -c electron.annotation.config.ts preview",
        "dev": "npm run build && npm run start",
        "build": "electron-vite -c electron.annotation.config.ts build",
        "test": "vitest run --config vitest.annotation.config.ts",
        "test:gateway": "python -m unittest discover -s gateway -p test_*.py -v",
        "release:win": "npm run build && node scripts/prepare-package.cjs && electron-builder --win zip --x64 -c annotation-builder.config.cjs --publish never",
        "ana": "electron-vite --ignoreConfigWarning preview --mode analyze",
        "uitest": "electron-vite -c electron.vite.config_test.ts",
        "typecheck": "tsc -p tsconfig.annotation.json",
        "typecheck:upstream": "tsc -b --noEmit --force",
        "format": "biome format --write src/",
        "lint": "biome check lib/annotation.ts lib/annotationIpc.ts lib/ipc.ts src/ShareTypes.d.ts src/main/annotationArchive.ts src/main/annotationAuth.ts src/main/annotationConfig.ts src/main/annotationMain.ts src/main/captureDefaults.ts src/main/formulaJobs.ts src/main/formulaProvider.ts src/renderer/annotation src/renderer/clip/clip_window.ts tests/annotation",
        "fix": "biome check --write src/"
    },
    "author": {
        "name": "xsf",
        "email": "xushengfeng_zg@163.com"
    },
    "homepage": "https://github.com/xushengfeng/eSearch/",
    "license": "GPL-3.0",
    "packageManager": "pnpm@10.17.0",
    "dependencies": {
        "@erase2d/fabric": "^1.2.1",
        "@pdf-lib/upng": "^1.0.1",
        "@xushengfeng/fasttext_wasm": "1.0.6",
        "bmp-js": "^0.1.0",
        "chroma-js": "^3.1.1",
        "diff-match-patch": "^1.0.5",
        "diff-match-patch-line-and-word": "^0.1.3",
        "dkh-ui": "^0.14.2",
        "edge_det": "^0.1.3",
        "esearch-ocr": "8.5.2",
        "esearch-seg": "1.1.9",
        "fabric": "^7.4.0",
        "fuse.js": "^7.1.0",
        "gifenc": "^1.0.3",
        "hex-to-css-filter": "^5.4.0",
        "hotkeys-js": "^3.13.7",
        "mediabunny": "^1.14.3",
        "minimist": "^1.2.8",
        "myde-dbus": "^0.5.2",
        "node-screenshots": "^0.2.8",
        "onnxruntime-node": "^1.27.0",
        "picture_match": "^0.1.4",
        "qr-scanner-wechat": "^0.1.3",
        "remarkable": "^2.0.1",
        "uiohook-napi": "^1.5.4",
        "xtranslator": "^1.6.0",
        "yauzl": "^3.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@inquirer/prompts": "^8.2.0",
        "@types/bmp-js": "^0.1.2",
        "@types/chroma-js": "^3.1.1",
        "@types/diff-match-patch": "^1.0.34",
        "@types/minimist": "^1.2.5",
        "@types/node": "^22.9.3",
        "@types/remarkable": "^2.0.8",
        "@types/yauzl": "^2.10.3",
        "canvas": "^3.1.0",
        "csv-parse": "^7.0.2",
        "electron": "44.9.3",
        "electron-builder": "^26.15.7",
        "electron-vite": "^4.0.1",
        "inquirer": "^12.7.0",
        "typescript": "^5.8.3",
        "vite": "^7.3.7",
        "vite-bundle-analyzer": "^1.2.0",
        "vite-plugin-image-optimizer": "^1.1.8",
        "vitest": "^4.1.11",
        "xtimelog": "^1.0.5"
    },
    "optionalDependencies": {
        "node-screenshots-darwin-arm64": "0.2.8",
        "node-screenshots-darwin-x64": "0.2.8",
        "node-screenshots-linux-arm64-gnu": "0.2.8",
        "node-screenshots-linux-loong64-gnu": "0.2.8",
        "node-screenshots-linux-x64-gnu": "0.2.8",
        "node-screenshots-linux-x64-musl": "0.2.8",
        "node-screenshots-win32-arm64-msvc": "0.2.8",
        "node-screenshots-win32-ia32-msvc": "0.2.8",
        "node-screenshots-win32-x64-msvc": "0.2.8"
    }
}
