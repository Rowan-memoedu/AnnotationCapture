{
  "manifest_version": 3,
  "name": "AnnotationCapture · Math Academy 填答",
  "description": "将批注工具圈选的手写答案填入当前 Math Academy 题目。",
  "version": "1.0.1",
  "minimum_chrome_version": "106",
